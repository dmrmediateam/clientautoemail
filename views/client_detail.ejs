<%
  const title = client.name;
  const webhookUrl = publicBaseUrl + '/v1/webhooks/incoming/' + client.id;
  const s = client.settings || {};
  const statusBadge = (s) => {
    if (s === 'sent') return '<span class="badge badge-on">Sent</span>';
    if (s === 'fallback') return '<span class="badge badge-warn">Fallback</span>';
    if (s === 'failed') return '<span class="badge badge-err">Failed</span>';
    if (s === 'queued') return '<span class="badge badge-warn">Queued</span>';
    return '<span class="badge badge-off">' + s + '</span>';
  };
  function timeAgo(ms) {
    const diff = Date.now() - ms;
    const m = Math.floor(diff / 60000);
    if (m < 1) return 'just now';
    if (m < 60) return m + 'm ago';
    const h = Math.floor(m / 60);
    if (h < 24) return h + 'h ago';
    return Math.floor(h / 24) + 'd ago';
  }
%>
<%- include('_header', { brand, page, flash, title }) %>

<div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
  <div>
    <h1><%= client.name %></h1>
    <p class="lede">
      <% if (client.active) { %><span class="badge badge-on">Active</span>
      <% } else { %><span class="badge badge-off">Paused</span><% } %>
      <% if (client.google.connected) { %><span class="badge badge-on">Gmail Connected</span>
      <% } else { %><span class="badge badge-warn">Gmail Not Connected</span><% } %>
      <% if (client.website) { %> · <span class="mono" style="font-size:13px"><%= client.website %></span><% } %>
    </p>
  </div>
  <div class="actions">
    <a class="btn" href="/admin/clients/<%= client.id %>/edit">Edit</a>
    <% if (client.active) { %>
      <form action="/admin/clients/<%= client.id %>/pause" method="post" style="display:inline">
        <button class="btn" type="submit">Pause auto-responses</button>
      </form>
    <% } else { %>
      <form action="/admin/clients/<%= client.id %>/resume" method="post" style="display:inline">
        <button class="btn btn-primary" type="submit">Resume auto-responses</button>
      </form>
    <% } %>
    <form action="/admin/clients/<%= client.id %>/impersonate" method="post" style="display:inline">
      <button class="btn" type="submit" style="background:var(--accent);color:#fff;border-color:var(--accent)">Open Team Dashboard →</button>
    </form>
  </div>
</div>

<div class="panel">
  <h2 style="margin-top:0">Setup</h2>
  <div class="kv" style="margin-bottom:12px">
    <div class="k">1. Agent login link</div>
    <div class="v">
      <div class="code-block"><%= publicBaseUrl %>/onboarding</div>
      <p class="help">Send this to the agent. They click "Connect Gmail" and sign in with the account that will send emails.</p>
    </div>
    <div class="k">2. Webhook URL</div>
    <div class="v">
      <div class="code-block"><%= webhookUrl %></div>
      <p class="help">Paste into Luxury Presence (or any lead source) as the POST destination. Method: POST · Content-Type: application/json</p>
    </div>
    <% if (client.settings && client.settings.cc_email) { %>
    <div class="k">CC on every email</div>
    <div class="v mono"><%= client.settings.cc_email %></div>
    <% } %>
  </div>
</div>

<div class="panel">
  <h2 style="margin-top:0">Identity</h2>
  <div class="kv">
    <div class="k">Agent name</div><div class="v"><%= client.agent_name %></div>
    <div class="k">From email</div><div class="v mono"><%= client.agent_email %></div>
    <div class="k">Phone</div><div class="v"><%= client.agent_phone || '—' %></div>
    <div class="k">Connected Gmail</div><div class="v mono"><%= client.google.email || '—' %></div>
    <div class="k">CC email</div><div class="v mono"><%= s.cc_email || '—' %></div>
    <div class="k">SendGrid key</div>
    <div class="v">
      <% if (client.sendgrid_api_key) { %><span class="badge badge-on">Per-client</span>
      <% } else { %><span class="badge badge-off">Master fallback</span><% } %>
    </div>
  </div>
</div>

<div class="panel">
  <h2 style="margin-top:0">Campaign settings</h2>
  <div class="kv">
    <div class="k">Send window</div>
    <div class="v"><%= s.send_window_start || '08:30' %> – <%= s.send_window_end || '18:00' %> &nbsp;<span class="mono" style="font-size:12px"><%= s.timezone || 'America/Chicago' %></span></div>
    <div class="k">Daily send cap</div><div class="v"><%= s.daily_send_limit || 5 %> emails/day</div>
    <div class="k">Buyer sender</div><div class="v mono"><%= s.buyer_sender_email || s.send_from_email || client.google.email || '— (owner account)' %></div>
    <div class="k">Seller sender</div><div class="v mono"><%= s.seller_sender_email || s.send_from_email || client.google.email || '— (owner account)' %></div>
    <div class="k">Team signature</div><div class="v"><%= s.team_signature_enabled ? 'Enabled — appends "' + client.name + ' Team"' : 'Disabled' %></div>
  </div>
</div>

<div class="panel">
  <h2 style="margin-top:0">Templates</h2>
  <div class="kv">
    <div class="k">Buyer subject</div><div class="v mono"><%= client.templates?.buyer?.subject || client.template?.subject || '—' %></div>
    <div class="k">Buyer body</div><div class="v"><pre class="code-block" style="white-space:pre-wrap;max-height:160px;overflow:auto"><%= client.templates?.buyer?.body || client.template?.body || '—' %></pre></div>
    <div class="k">Seller subject</div><div class="v mono"><%= client.templates?.seller?.subject || '—' %></div>
    <div class="k">Seller body</div><div class="v"><pre class="code-block" style="white-space:pre-wrap;max-height:160px;overflow:auto"><%= client.templates?.seller?.body || '—' %></pre></div>
  </div>
  <div class="actions" style="margin-top:14px">
    <a class="btn" href="/admin/clients/<%= client.id %>/edit">Edit templates &amp; settings</a>
  </div>
</div>

<% if (typeof teamMembers !== 'undefined' && teamMembers.length > 0) { %>
<div class="panel">
  <h2 style="margin-top:0">Team members</h2>
  <table>
    <thead><tr><th>Email</th><th>Name</th><th>Role</th><th>Gmail</th></tr></thead>
    <tbody>
      <% teamMembers.forEach(u => { %>
        <tr>
          <td class="mono" style="font-size:13px"><%= u.email %></td>
          <td><%= u.name || '—' %></td>
          <td><span class="badge <%= u.role === 'owner' ? 'badge-on' : 'badge-off' %>"><%= u.role %></span></td>
          <td>
            <% if (u.connected) { %><span class="badge badge-on">Connected</span>
            <% } else { %><span class="badge badge-warn">Not connected</span><% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<div class="panel">
  <h2 style="margin-top:0">Send a test</h2>
  <form action="/admin/clients/<%= client.id %>/test" method="post">
    <label>Recipient email</label>
    <input class="input" type="email" name="to" value="<%= client.agent_email %>" />
    <p class="help">A sample lead is generated and sent through the same pipeline a real webhook uses.</p>
    <div class="actions" style="margin-top:14px">
      <button type="submit" class="btn btn-primary" <%= !client.google.connected ? 'disabled' : '' %>>Send test email</button>
      <% if (!client.google.connected) { %><span class="help">Client must sign in via /onboarding first.</span><% } %>
    </div>
  </form>
</div>

<h2>Conversations &amp; recent activity</h2>
<div class="panel">
  <% const convList = typeof conversations !== 'undefined' ? conversations : []; %>
  <% if (convList.length === 0) { %>
    <div class="empty">No leads yet.</div>
  <% } else { %>
    <table>
      <thead><tr><th>When</th><th>Lead</th><th>Type</th><th>Property</th><th>Last email</th><th>Status</th></tr></thead>
      <tbody>
        <% convList.forEach(c => { %>
          <tr>
            <td class="mono" style="font-size:11px"><%= timeAgo(c.last_message_at) %></td>
            <td>
              <div style="font-weight:500;font-size:13px"><%= c.lead_name || c.lead_email %></div>
              <% if (c.lead_name) { %><div class="mono" style="font-size:11px;color:var(--fg-muted)"><%= c.lead_email %></div><% } %>
            </td>
            <td><span class="badge <%= c.lead_type === 'seller' ? 'badge-warn' : 'badge-off' %>"><%= c.lead_type || 'buyer' %></span></td>
            <td style="font-size:12px;color:var(--fg-muted);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.property_address || '—' %></td>
            <td style="font-size:12px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.last_subject || '—' %></td>
            <td><%- statusBadge(c.last_status || 'queued') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="panel" style="border-color: rgba(248,113,113,.3)">
  <h2 style="margin-top:0;color:var(--error)">Danger zone</h2>
  <form action="/admin/clients/<%= client.id %>/delete" method="post"
        onsubmit="return confirm('Delete <%= client.name.replace(/'/g, "\\'") %> and all its lead history? This cannot be undone.');">
    <button class="btn btn-danger" type="submit">Delete client</button>
  </form>
</div>

<%- include('_footer') %>
