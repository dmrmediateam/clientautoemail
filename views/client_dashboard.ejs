<%
  const title = 'Dashboard';
  const page = 'dashboard';
  const webhookUrl = publicBaseUrl + '/v1/webhooks/incoming/' + client.id;
  const isLive = client.active && client.google.connected;
  const nextSendLocal = new Date(nextSendAt).toLocaleString('en-US', {
    timeZone: client.settings?.timezone || 'America/Chicago',
    month: 'short', day: 'numeric',
    hour: 'numeric', minute: '2-digit',
  });
  const sentMessages = recentMessages.filter(m => m.direction === 'outbound');
  const sentCount = sentMessages.filter(m => m.status === 'sent').length;
%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %> — <%= brand.name %></title>
<link rel="stylesheet" href="/static/css/dmr.css" />
<style>
  .status-hero {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 28px 28px 24px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .status-hero .left h1 { margin: 0 0 6px; font-size: 22px; }
  .status-hero .sub { color: var(--fg-muted); font-size: 13px; margin-top: 6px; }
  .live-dot { display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--success); margin-right:6px; animation:pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
  .stats { display:grid; gap:14px; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); margin-bottom:20px; }
  .stat { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px 20px; }
  .stat .s-label { font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--fg-muted); }
  .stat .s-value { font-size:26px; font-weight:700; font-family:var(--mono); margin-top:4px; }
  .stat .s-sub   { font-size:11px; color:var(--fg-muted); margin-top:2px; }
  .checklist { list-style:none; margin:0; padding:0; }
  .checklist li { display:flex; align-items:flex-start; gap:12px; padding:10px 0; border-bottom:1px solid var(--border); }
  .checklist li:last-child { border-bottom:0; }
  .check-icon { width:22px; height:22px; border-radius:50%; flex-shrink:0; margin-top:1px; display:grid; place-items:center; font-size:11px; }
  .check-done { background:#DCFCE7; color:var(--success); border:1px solid #BBF7D0; }
  .check-todo { background:var(--surface-2); color:var(--fg-muted); border:1px solid var(--border); }
  .check-label strong { display:block; font-size:14px; margin-bottom:2px; }
  .check-label span   { font-size:12px; color:var(--fg-muted); }
  /* Activity feed */
  .activity { list-style:none; margin:0; padding:0; }
  .activity-item {
    display:grid; grid-template-columns:1fr auto;
    gap:4px 16px; padding:16px 0; border-bottom:1px solid var(--border); align-items:start;
  }
  .activity-item:last-child { border-bottom:0; }
  .act-lead { font-weight:600; font-size:14px; }
  .act-email { font-size:12px; color:var(--fg-muted); font-family:var(--mono); margin-top:1px; }
  .act-prop  { font-size:12px; color:var(--fg-muted); margin-top:3px; }
  .act-reply { font-size:12px; margin-top:6px; padding:8px 10px; background:var(--surface-2); border-radius:6px; border-left:3px solid var(--border); }
  .act-reply .reply-label { font-size:10px; text-transform:uppercase; letter-spacing:.8px; color:var(--fg-muted); margin-bottom:3px; }
  .act-reply .reply-subject { font-size:13px; font-weight:500; }
  .act-reply .reply-status  { margin-top:4px; }
  .act-meta { display:flex; flex-direction:column; align-items:flex-end; gap:6px; }
  .act-time { font-size:11px; color:var(--fg-muted); font-family:var(--mono); white-space:nowrap; }
  /* Messages tab */
  .tab-bar { display:flex; gap:0; border-bottom:1px solid var(--border); margin:-20px -20px 20px; padding:0 20px; }
  .tab-bar button { background:none; border:none; padding:12px 16px; font-size:13px; color:var(--fg-muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
  .tab-bar button.active { color:var(--accent); border-bottom-color:var(--accent); }
  .tab-content { display:none; }
  .tab-content.active { display:block; }
  .msg-row { display:grid; grid-template-columns:1fr auto auto; gap:8px 16px; padding:12px 0; border-bottom:1px solid var(--border); align-items:center; }
  .msg-row:last-child { border-bottom:0; }
  .msg-to   { font-size:13px; font-weight:500; }
  .msg-sub  { font-size:12px; color:var(--fg-muted); margin-top:2px; }
  .msg-time { font-size:11px; color:var(--fg-muted); font-family:var(--mono); white-space:nowrap; text-align:right; }
</style>
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">DMR</div>
      <div class="brand-text">
        <span class="name"><%= brand.name %></span>
        <span class="tagline"><%= brand.tagline %></span>
      </div>
    </div>
    <nav class="nav">
      <a href="/dashboard" class="active">Dashboard</a>
      <a href="/dashboard/template">Template</a>
      <span style="color:var(--fg-muted);font-size:12px;padding:0 6px">
        <% var _me = currentUser ? currentUser.email : (client.google.email || client.agent_email); %>
        <%= _me %>
        <span style="margin-left:4px;opacity:.5">·</span>
        <span style="color:var(--accent);font-weight:600"><%= client.name %></span>
      </span>
      <% if (typeof isAdminImpersonating !== 'undefined' && isAdminImpersonating) { %>
        <form action="/admin/stop-impersonating" method="post" style="display:inline;margin-left:6px">
          <button class="btn" type="submit" style="background:#F59E0B;color:#000;border-color:#F59E0B">← Admin Panel</button>
        </form>
      <% } else { %>
        <form action="/auth/logout" method="post" style="display:inline">
          <button class="btn btn-ghost" type="submit">Sign out</button>
        </form>
      <% } %>
    </nav>
  </header>

  <main class="main">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
    <% } %>

    <div class="status-hero">
      <div class="left">
        <h1>
          <% if (isLive) { %><span class="live-dot"></span><% } %>
          <%= client.name %>
        </h1>
        <div class="sub" style="margin-bottom:4px;font-size:13px;color:var(--fg-muted)">
          Agent: <strong style="color:var(--fg)"><%= client.agent_name %></strong>
          <% if (currentUser) { %>
            &nbsp;·&nbsp; <span class="mono" style="font-size:12px"><%= currentUser.email %></span>
            <span class="badge" style="font-size:10px;padding:2px 6px;margin-left:4px;vertical-align:middle"><%= currentUser.role %></span>
          <% } %>
        </div>
        <div>
          <% if (isLive) { %>
            <span class="badge badge-on">Live</span>
            <span style="color:var(--fg-muted);font-size:13px;margin-left:8px">Sending via <span class="mono"><%= client.settings.send_from_email || client.google.email %></span></span>
          <% } else if (!client.google.connected) { %>
            <span class="badge badge-warn">Needs Setup</span>
            <span style="color:var(--fg-muted);font-size:13px;margin-left:8px">Connect Gmail below to go live.</span>
          <% } else { %>
            <span class="badge badge-off">Paused</span>
            <span style="color:var(--fg-muted);font-size:13px;margin-left:8px">Webhooks are being ignored.</span>
          <% } %>
        </div>
        <div class="sub">
          <% if (client.website) { %><%= client.website %><% } %>
        </div>
      </div>
      <div class="actions">
        <a class="btn" href="/dashboard/template">Settings</a>
        <% if (client.active && client.google.connected) { %>
          <form action="/dashboard/pause" method="post" style="display:inline">
            <button class="btn" type="submit">Pause</button>
          </form>
        <% } else if (client.active && !client.google.connected) { %>
          <a class="btn btn-primary" href="/auth/google/start">Connect Gmail</a>
        <% } else { %>
          <form action="/dashboard/resume" method="post" style="display:inline">
            <button class="btn btn-primary" type="submit">Resume</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="s-label">Leads received</div>
        <div class="s-value"><%= conversations.length %></div>
        <div class="s-sub">all time</div>
      </div>
      <div class="stat">
        <div class="s-label">Emails sent</div>
        <div class="s-value"><%= sentCount %></div>
        <div class="s-sub">all time</div>
      </div>
      <div class="stat">
        <div class="s-label">Next send window</div>
        <div class="s-value" style="font-size:14px;line-height:1.4;margin-top:6px"><%= nextSendLocal %></div>
        <div class="s-sub"><%= client.settings?.timezone || 'America/Chicago' %></div>
      </div>
      <div class="stat">
        <div class="s-label">From address</div>
        <div class="s-value" style="font-size:13px;line-height:1.4;margin-top:6px"><%= client.google.email || '—' %></div>
        <% if (client.settings && client.settings.cc_email) { %>
          <div class="s-sub">CC: <%= client.settings.cc_email %></div>
        <% } %>
      </div>
    </div>

    <% if (!isLive || conversations.length === 0) { %>
    <div class="panel" style="margin-bottom:20px">
      <h2 style="margin-top:0">Getting started</h2>
      <ul class="checklist">
        <li>
          <div class="check-icon <%= client.google.connected ? 'check-done' : 'check-todo' %>">
            <%= client.google.connected ? '✓' : '1' %>
          </div>
          <div class="check-label">
            <strong>Connect Gmail</strong>
            <% if (client.google.connected) { %>
              <span>Connected as <%= client.google.email %></span>
            <% } else { %>
              <span><a href="/auth/google/start">Authorize your Google account</a> — takes 30 seconds.</span>
            <% } %>
          </div>
        </li>
        <li>
          <div class="check-icon check-done">✓</div>
          <div class="check-label">
            <strong>Add webhook to Luxury Presence</strong>
            <span>LP Dashboard → Settings → Lead Notifications → Webhook. Copy the URL below.</span>
          </div>
        </li>
        <li>
          <div class="check-icon <%= conversations.length > 0 ? 'check-done' : 'check-todo' %>">
            <%= conversations.length > 0 ? '✓' : '3' %>
          </div>
          <div class="check-label">
            <strong>Receive your first lead</strong>
            <span>Use the test button below to verify delivery before your first real lead arrives.</span>
          </div>
        </li>
      </ul>
    </div>
    <% } %>

    <div class="panel" style="margin-bottom:20px">
      <h2 style="margin-top:0">Lead activity</h2>
      <% if (conversations.length === 0) { %>
        <div class="empty">No leads yet — once webhooks arrive they will appear here.</div>
      <% } else { %>
        <div class="tab-bar">
          <button class="active" onclick="switchTab(this,'tab-leads')">Leads in (<%= conversations.length %>)</button>
          <button onclick="switchTab(this,'tab-messages')">Emails out (<%= sentCount %>)</button>
        </div>

        <div id="tab-leads" class="tab-content active">
          <ul class="activity">
            <% conversations.forEach(c => {
              const sm = { sent:'badge-on', failed:'badge-err', queued:'badge-off', rate_limited:'badge-warn' };
              const sc = sm[c.last_status] || 'badge-off';
              const dateStr = new Date(c.last_message_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
              const timeStr = new Date(c.last_message_at).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'});
            %>
            <li class="activity-item">
              <div>
                <div class="act-lead"><%= c.lead_name || c.lead_email %></div>
                <% if (c.lead_name) { %><div class="act-email"><%= c.lead_email %></div><% } %>
                <% if (c.property_address) { %><div class="act-prop">🏠 <%= c.property_address %></div><% } %>
                <% if (c.last_subject) { %>
                <div class="act-reply">
                  <div class="reply-label">Reply sent</div>
                  <div class="reply-subject"><%= c.last_subject %></div>
                  <div class="reply-status">
                    <span class="badge <%= sc %>"><%= c.last_status || 'queued' %></span>
                  </div>
                </div>
                <% } %>
              </div>
              <div class="act-meta">
                <span class="badge <%= c.lead_type === 'seller' ? 'badge-warn' : 'badge-off' %>"><%= c.lead_type || 'buyer' %></span>
                <div class="act-time"><%= dateStr %></div>
                <div class="act-time"><%= timeStr %></div>
                <a class="btn" style="padding:5px 10px;font-size:12px" href="/dashboard/conversations/<%= c.id %>">View →</a>
              </div>
            </li>
            <% }) %>
          </ul>
        </div>

        <div id="tab-messages" class="tab-content">
          <% if (sentMessages.length === 0) { %>
            <div class="empty">No emails sent yet.</div>
          <% } else { %>
            <% sentMessages.forEach(m => {
              const sm2 = { sent:'badge-on', failed:'badge-err', queued:'badge-off', rate_limited:'badge-warn' };
              const sc2 = sm2[m.status] || 'badge-off';
              const ts2 = m.sent_at || m.created_at;
              const d2 = new Date(ts2).toLocaleDateString('en-US',{month:'short',day:'numeric'});
              const t2 = new Date(ts2).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'});
            %>
            <div class="msg-row">
              <div>
                <div class="msg-to">To: <%= m.to_email %></div>
                <div class="msg-sub"><%= m.subject %></div>
              </div>
              <span class="badge <%= sc2 %>"><%= m.status %></span>
              <div class="msg-time"><%= d2 %><br><%= t2 %></div>
            </div>
            <% }) %>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="panel" style="margin-bottom:20px">
      <h2 style="margin-top:0">Webhook URL</h2>
      <p class="lede" style="margin-bottom:14px">Paste into Luxury Presence as your POST lead destination.</p>
      <div style="display:flex;gap:8px;align-items:stretch">
        <input id="hookUrl" class="input mono" readonly value="<%= webhookUrl %>" style="flex:1" />
        <button class="btn btn-primary" type="button" onclick="copyHook(this)">Copy</button>
      </div>
      <p class="help">Method: <strong>POST</strong> · Content-Type: <strong>application/json</strong></p>
    </div>

    <div class="panel" style="margin-bottom:20px">
      <h2 style="margin-top:0">Send a test</h2>
      <form action="/dashboard/test" method="post">
        <div style="display:flex;gap:8px;align-items:stretch">
          <input class="input" type="email" name="to" value="<%= client.google.email || client.agent_email %>" style="flex:1" placeholder="recipient@example.com" />
          <button type="submit" class="btn btn-primary"<%= !client.google.connected ? ' disabled title="Connect Gmail first"' : '' %>>Send test</button>
        </div>
        <p class="help">Fires a sample lead through the full pipeline. Check your Gmail Sent folder to confirm delivery.</p>
      </form>
    </div>

    <div class="panel" style="margin-bottom:20px">
      <h2 style="margin-top:0">Your identity</h2>
      <form action="/dashboard/identity" method="post">
        <div class="row">
          <div>
            <label>Your name <span style="font-size:11px">(appears in "From")</span></label>
            <input class="input" name="agent_name" value="<%= client.agent_name %>" />
          </div>
          <div>
            <label>Phone <span style="font-size:11px">(used as <span class="mono">{{agent_phone}}</span>)</span></label>
            <input class="input" name="agent_phone" value="<%= client.agent_phone %>" />
          </div>
        </div>
        <div class="row">
          <div>
            <label>Brokerage / business name</label>
            <input class="input" name="name" value="<%= client.name %>" />
          </div>
          <div>
            <label>Website</label>
            <input class="input" name="website" value="<%= client.website %>" />
          </div>
        </div>
        <div class="actions" style="margin-top:16px">
          <button type="submit" class="btn btn-primary">Save</button>
          <a class="btn" href="/dashboard/template">Edit email template →</a>
        </div>
      </form>
    </div>

    <div class="panel" style="border-color:rgba(248,113,113,.25)">
      <h2 style="margin-top:0;color:var(--fg-muted);font-size:13px;text-transform:uppercase;letter-spacing:.8px">Danger zone</h2>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
        <div>
          <strong style="font-size:14px">Disconnect Google</strong>
          <p class="help" style="margin:2px 0 0">Removes sending access. Your leads and history stay. Reconnect anytime.</p>
        </div>
        <form action="/auth/disconnect" method="post" onsubmit="return confirm('Disconnect Google? Sending will stop until you reconnect.');">
          <button class="btn btn-danger" type="submit">Disconnect</button>
        </form>
      </div>
    </div>

  </main>

  <footer class="foot">
    <span>&copy; <%= new Date().getFullYear() %> <%= brand.name %></span>
    <span class="mono" style="font-size:11px"><%= brand.domain %></span>
  </footer>
</div>

<script>
function copyHook(btn) {
  navigator.clipboard.writeText(document.getElementById('hookUrl').value).then(() => {
    const orig = btn.textContent;
    btn.textContent = 'Copied ✓';
    btn.style.cssText = 'background:var(--success);border-color:var(--success);color:#0a1a0f';
    setTimeout(() => { btn.textContent = orig; btn.style.cssText = ''; }, 2000);
  });
}
function switchTab(btn, id) {
  const panel = btn.closest('.panel');
  panel.querySelectorAll('.tab-bar button').forEach(b => b.classList.remove('active'));
  panel.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  panel.querySelector('#' + id).classList.add('active');
}
</script>
</body>
</html>
