<%
  const title = 'Dashboard';
  const page = 'dashboard';
  const webhookUrl = publicBaseUrl + '/v1/webhooks/incoming/' + client.id;
%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %> — <%= brand.name %> · <%= brand.tagline %></title>
<link rel="stylesheet" href="/static/css/dmr.css" />
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">DMR</div>
      <div class="brand-text">
        <span class="name"><%= brand.name %></span>
        <span class="tagline"><%= brand.tagline %></span>
      </div>
    </div>
    <nav class="nav">
      <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/dashboard/template" class="<%= page === 'template' ? 'active' : '' %>">Template</a>
      <span style="color:var(--fg-muted);font-size:12px;margin:0 6px"><%= client.google.email || client.agent_email %></span>
      <form action="/auth/logout" method="post" style="display:inline">
        <button class="btn btn-ghost" type="submit">Sign out</button>
      </form>
    </nav>
  </header>
  <main class="main">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
  <% } %>

<h1>Welcome, <%= client.agent_name || client.google.email %></h1>
<p class="lede">
  <% if (client.active && client.google.connected) { %>
    <span class="badge badge-on">Active</span> Your bridge is live and ready to receive leads.
  <% } else if (!client.active) { %>
    <span class="badge badge-off">Paused</span> Webhooks are being ignored until you resume.
  <% } else { %>
    <span class="badge badge-warn">Disconnected</span> Reconnect Gmail to start sending.
  <% } %>
</p>

<div class="panel">
  <h2 style="margin-top:0">Your webhook URL</h2>
  <p class="lede">Paste this into Luxury Presence (or any lead-gen tool) as the destination for new leads.</p>
  <div style="display:flex;gap:8px;align-items:stretch">
    <input id="hookUrl" class="input mono" readonly value="<%= webhookUrl %>" style="flex:1" />
    <button class="btn btn-primary" type="button" onclick="copyHook()">Copy</button>
  </div>
  <p class="help">Method: POST · Content-Type: application/json. <a href="#payload">Payload format below.</a></p>
</div>

<div class="cards">
  <div class="card">
    <div class="label">Connected Gmail</div>
    <div class="value mono" style="font-size:14px;word-break:break-all"><%= client.google.email || '—' %></div>
  </div>
  <div class="card">
    <div class="label">Conversations</div>
    <div class="value"><%= conversations.length %><span style="color:var(--fg-muted);font-size:13px;font-weight:400"> total</span></div>
  </div>
  <div class="card">
    <div class="label">Status</div>
    <div class="value" style="font-size:18px">
      <% if (client.active) { %><span class="badge badge-on">Active</span><% } else { %><span class="badge badge-off">Paused</span><% } %>
    </div>
  </div>
  <div class="card">
    <div class="label">Sent Today</div>
    <div class="value"><%= sentToday %> / <%= client.settings?.daily_send_limit || 5 %></div>
  </div>
</div>

<div class="panel">
  <h2 style="margin-top:0">Send a test</h2>
  <form action="/dashboard/test" method="post">
    <label>Send a test email to:</label>
    <div style="display:flex;gap:8px;align-items:stretch">
      <input class="input" type="email" name="to" value="<%= client.google.email || client.agent_email %>" style="flex:1" />
      <button type="submit" class="btn btn-primary">Send test</button>
    </div>
    <p class="help">A sample lead is generated and sent through the same pipeline a real webhook uses. The email will appear in your Gmail Sent folder.</p>
  </form>
</div>

<div class="panel">
  <h2 style="margin-top:0">Your identity</h2>
  <form action="/dashboard/identity" method="post">
    <div class="row">
      <div>
        <label>Display name (your name as it appears in the "From")</label>
        <input class="input" name="agent_name" value="<%= client.agent_name %>" />
      </div>
      <div>
        <label>Phone (used in templates as {{agent_phone}})</label>
        <input class="input" name="agent_phone" value="<%= client.agent_phone %>" />
      </div>
    </div>
    <div class="row">
      <div>
        <label>Brokerage / business name</label>
        <input class="input" name="name" value="<%= client.name %>" />
      </div>
      <div>
        <label>Website</label>
        <input class="input" name="website" value="<%= client.website %>" />
      </div>
    </div>
    <div class="actions" style="margin-top:18px">
      <button type="submit" class="btn btn-primary">Save</button>
      <a class="btn" href="/dashboard/template">Edit template →</a>
    </div>
  </form>
</div>

<div class="panel">
  <h2 style="margin-top:0">Inbox conversations</h2>
  <p class="help">Next business-window send: <%= new Date(nextSendAt).toLocaleString() %> (<%= client.settings?.timezone || 'America/Chicago' %>)</p>
  <% if (conversations.length === 0) { %>
    <div class="empty">No conversations yet. As webhooks arrive and replies come in, they will appear here.</div>
  <% } else { %>
    <table>
      <thead><tr><th>When</th><th>Lead</th><th>Type</th><th>Last message</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% conversations.forEach(c => { %>
          <tr>
            <td class="mono" style="font-size:12px"><%= new Date(c.last_message_at).toLocaleString() %></td>
            <td>
              <strong><%= c.lead_name || c.lead_email %></strong>
              <div class="mono" style="font-size:12px;color:var(--fg-muted)"><%= c.lead_email %></div>
            </td>
            <td><span class="badge"><%= c.lead_type || 'buyer' %></span></td>
            <td>
              <div><%= c.last_subject || 'No subject yet' %></div>
              <div style="font-size:12px;color:var(--fg-muted)"><%= (c.last_body || '').slice(0, 80) %></div>
            </td>
            <td><span class="badge badge-off"><%= c.last_status || c.status %></span></td>
            <td><a class="btn" href="/dashboard/conversations/<%= c.id %>">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="panel" id="payload">
  <h2 style="margin-top:0">Webhook payload format</h2>
  <p class="lede">Send a JSON POST. Field names are flexible — both <span class="mono">first_name</span> and <span class="mono">firstName</span> work.</p>
  <pre class="code-block">{
  "name": "Jane Doe",
  "email": "jane@example.com",
  "phone": "555-0101",
  "property_address": "123 Beverly Dr, Beverly Hills, CA",
  "property_url": "https://example.com/listing/123",
  "message": "I'm interested"
}</pre>
</div>

<div class="panel" style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;justify-content:space-between">
  <div>
    <h2 style="margin:0">Pause / resume</h2>
    <p class="help" style="margin:4px 0 0">Pausing keeps your account but stops dispatching webhooks.</p>
  </div>
  <% if (client.active) { %>
    <form action="/dashboard/pause" method="post"><button class="btn" type="submit">Pause bridge</button></form>
  <% } else { %>
    <form action="/dashboard/resume" method="post"><button class="btn btn-primary" type="submit">Resume bridge</button></form>
  <% } %>
</div>

<div class="panel" style="border-color: rgba(248,113,113,.3)">
  <h2 style="margin-top:0;color:var(--error)">Disconnect Google</h2>
  <p class="help">Removes our access to send on your behalf. Your data stays; you can sign back in anytime.</p>
  <form action="/auth/disconnect" method="post" onsubmit="return confirm('Disconnect Google? Webhooks will stop sending until you reconnect.');">
    <button class="btn btn-danger" type="submit">Disconnect Google</button>
  </form>
</div>

<script>
function copyHook(){
  const el = document.getElementById('hookUrl');
  el.select(); el.setSelectionRange(0, 99999);
  navigator.clipboard.writeText(el.value).then(() => {
    const btn = event.target;
    const old = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = old, 1500);
  });
}
</script>

  </main>
  <footer class="foot">
    <span>&copy; <%= new Date().getFullYear() %> <%= brand.name %></span>
    <span class="mono"><%= brand.domain %></span>
  </footer>
</div>
</body>
</html>
