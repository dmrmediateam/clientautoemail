<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= brand.name %> Lead Responder</title>
<meta name="description" content="Connect your Gmail to <%= brand.name %> Lead Responder and start sending instant, personalized responses to every real estate lead.">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= brand.name %> Lead Responder — Automated Lead Response">
<meta property="og:description" content="Instant, personalized email responses for every real estate lead. Powered by <%= brand.name %>.">
<meta name="theme-color" content="#C9A66B">
<link rel="stylesheet" href="/static/css/dmr.css" />
<style>
  .hero { max-width: 720px; margin: 0 auto; text-align: center; padding: 80px 24px 32px; }
  .hero h1 { font-size: 44px; line-height: 1.1; margin: 18px 0 12px; letter-spacing: -.5px; }
  .hero h1 .accent { color: var(--accent); }
  .hero p.lede { font-size: 17px; max-width: 560px; margin: 0 auto 32px; }
  .gbtn {
    display: inline-flex; align-items: center; gap: 12px;
    background: #fff; color: #1f2937;
    padding: 14px 24px; border-radius: 10px;
    font-weight: 600; font-size: 15px;
    border: 1px solid var(--border);
    transition: transform .12s, box-shadow .12s;
  }
  .gbtn:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(0,0,0,.3); text-decoration: none; }
  .gbtn svg { width: 20px; height: 20px; }
  .features { max-width: 880px; margin: 60px auto 40px; padding: 0 24px;
              display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .feature { background: var(--surface); border: 1px solid var(--border);
             border-radius: var(--radius); padding: 22px; }
  .feature h3 { margin: 0 0 8px; font-size: 16px; color: var(--accent); }
  .feature p { margin: 0; color: var(--fg-muted); font-size: 14px; line-height: 1.55; }
  .micro { color: var(--fg-muted); font-size: 12px; margin-top: 14px; }
  .top-strip { padding: 18px 28px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
</style>
</head>
<body>
<div class="shell">
  <div class="top-strip">
    <div class="brand">
      <div class="brand-mark">DMR</div>
      <div class="brand-text">
        <span class="name"><%= brand.name %></span>
        <span class="tagline"><%= brand.tagline %></span>
      </div>
    </div>
  </div>

  <main class="main" style="padding-top: 0;">
    <% if (flash) { %><div class="flash flash-<%= flash.type %>" style="max-width:560px;margin:24px auto 0"><%= flash.text %></div><% } %>

    <div class="hero">
      <p style="font-size:22px;font-weight:700;color:var(--fg);margin:0 0 8px;letter-spacing:-.3px"><%= brand.name %> Lead Responder</p>
      <h1>Reply to every lead<br><span class="accent">in under 5 seconds.</span></h1>
      <p class="lede">
        Connect your Gmail. Drop a webhook URL into Luxury Presence (or any lead-gen tool).
        Every new lead gets a personalized email <strong>from you</strong>, instantly — sitting in your Sent folder, ready for them to reply.
      </p>

      <a href="/auth/google/start" class="gbtn">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#4285f4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34a853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#fbbc05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#ea4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Sign in with Google
      </a>
      <p class="micro">We only request permission to <strong>send mail on your behalf</strong> (<code>gmail.send</code> scope). We never read your inbox.</p>
      <p class="micro" style="margin-top:6px">
        By continuing you agree to our <a href="/terms" style="color:var(--accent)">Terms of Service</a> and <a href="/privacy" style="color:var(--accent)">Privacy Policy</a>.
      </p>
    </div>

    <div class="features">
      <div class="feature">
        <h3>Looks 100% authentic</h3>
        <p>Email is sent from your real Gmail through Google's own servers. It lands in your Sent folder, signed by Google's DKIM keys. Indistinguishable from typing it yourself.</p>
      </div>
      <div class="feature">
        <h3>Replies come straight to you</h3>
        <p>When the lead hits "Reply," it goes directly to your Gmail inbox. No relay, no proxy, no DMR Media in the middle.</p>
      </div>
      <div class="feature">
        <h3>Fully customizable</h3>
        <p>Edit your subject line and message body any time from your dashboard. Use placeholders like <span class="mono">{{first_name}}</span> and <span class="mono">{{property_address}}</span>.</p>
      </div>
    </div>
  </main>

  <footer class="foot">
    <span>&copy; <%= new Date().getFullYear() %> <%= brand.name %></span>
    <span>
      <a href="/privacy" style="color:var(--fg-muted);font-size:12px;margin-right:14px">Privacy Policy</a>
      <a href="/terms" style="color:var(--fg-muted);font-size:12px;margin-right:14px">Terms of Service</a>
      <a href="mailto:team@dmrmedia.org" style="color:var(--fg-muted);font-size:12px">Contact</a>
    </span>
    <span class="mono" style="font-size:11px"><%= brand.domain %></span>
  </footer>
</div>
</body>
</html>
