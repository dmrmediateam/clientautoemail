<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= typeof title !== 'undefined' && title ? title + ' — ' : '' %><%= brand.name %> · <%= brand.tagline %></title>
<link rel="stylesheet" href="/static/css/dmr.css" />
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">DMR</div>
      <div class="brand-text">
        <span class="name"><%= brand.name %></span>
        <span class="tagline"><%= brand.tagline %></span>
      </div>
    </div>
    <nav class="nav">
      <a href="/admin" class="<%= page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/admin/leads" class="<%= page === 'leads' ? 'active' : '' %>">CRM</a>
      <a href="/admin/clients/new" class="<%= page === 'clients' ? 'active' : '' %>">+ Add Client</a>
      <form action="/logout" method="post" style="display:inline;margin-left:6px">
        <button class="btn btn-ghost" type="submit">Sign out</button>
      </form>
    </nav>
  </header>
  <main class="main">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
  <% } %>
