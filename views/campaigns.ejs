<%
  const title = 'Campaigns';
  const page  = 'campaigns';

  function fmtWindow(start, end, tz) {
    function to12(t) {
      if (!t) return '';
      const [h, m] = t.split(':').map(Number);
      const ampm = h >= 12 ? 'PM' : 'AM';
      const h12  = h % 12 || 12;
      return m === 0 ? `${h12} ${ampm}` : `${h12}:${String(m).padStart(2,'0')} ${ampm}`;
    }
    return `${to12(start)} – ${to12(end)}`;
  }

  const s = client.settings || {};
  const sendWindow = fmtWindow(s.send_window_start || '08:30', s.send_window_end || '18:00');
  const tz         = s.timezone || 'America/Chicago';

  const campaigns = [
    {
      key:       'seller',
      label:     'Seller Campaign',
      icon:      '🏡',
      paused:    !!s.seller_paused,
      sender:    s.seller_sender_email || s.send_from_email || (client.google && client.google.email) || client.agent_email || '—',
      subject:   (client.templates && client.templates.seller && client.templates.seller.subject) || client.template && client.template.subject || '—',
      leads:     stats.seller_leads || 0,
      sent:      stats.seller_sent  || 0,
      desc:      'Automatically respond to home-value and listing inquiries from sellers.',
    },
    {
      key:       'buyer',
      label:     'Buyer Campaign',
      icon:      '🔑',
      paused:    !!s.buyer_paused,
      sender:    s.buyer_sender_email || s.send_from_email || (client.google && client.google.email) || client.agent_email || '—',
      subject:   (client.templates && client.templates.buyer && client.templates.buyer.subject) || client.template && client.template.subject || '—',
      leads:     stats.buyer_leads || 0,
      sent:      stats.buyer_sent  || 0,
      desc:      'Automatically respond to property inquiries and showing requests from buyers.',
    },
  ];
%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %> — <%= brand.name %></title>
<link rel="stylesheet" href="/static/css/dmr.css" />
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">DMR</div>
      <div class="brand-text">
        <span class="name"><%= brand.name %></span>
        <span class="tagline"><%= brand.tagline %></span>
      </div>
    </div>
    <nav class="nav">
      <span style="color:var(--fg-muted);font-size:12px;padding:0 6px">
        <%= client.google.email || client.agent_email %>
        <span style="margin-left:4px;opacity:.5">&middot;</span>
        <span style="color:var(--accent);font-weight:600"><%= client.name %></span>
      </span>
      <form action="/auth/logout" method="post" style="display:inline">
        <button class="btn btn-ghost" type="submit">Sign out</button>
      </form>
    </nav>
  </header>

  <div class="dash-body">
    <%- sidebarHtml %>

    <main class="dash-content">
    <div class="dash-content-inner">

      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
      <% } %>

      <div style="margin-bottom:24px">
        <h1 style="margin:0 0 6px">Campaigns</h1>
        <p style="margin:0;color:var(--fg-muted);font-size:14px">Manage automated email campaigns. Each campaign responds to new leads within your send window.</p>
      </div>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;margin-bottom:24px;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
        <div style="font-size:13px;color:var(--fg-muted)">&#128336; <strong style="color:var(--fg)">Send window:</strong> <%= sendWindow %></div>
        <div style="font-size:13px;color:var(--fg-muted)">&#127758; <strong style="color:var(--fg)">Timezone:</strong> <%= tz %></div>
        <div style="font-size:13px;color:var(--fg-muted)">&#9203; <strong style="color:var(--fg)">Fires:</strong> within 15 min of lead arriving during window</div>
        <a href="/dashboard/template" style="margin-left:auto;font-size:13px;font-weight:600;color:var(--accent)">Edit templates &#8594;</a>
      </div>

      <div class="campaign-grid">
        <% campaigns.forEach(function(camp) { %>
        <div class="campaign-card <%= camp.paused ? 'paused' : '' %>">

          <div class="campaign-card-head">
            <div style="display:flex;align-items:center;gap:10px">
              <span style="font-size:22px"><%= camp.icon %></span>
              <div>
                <div class="ctitle"><%= camp.label %></div>
                <div style="font-size:12px;color:var(--fg-muted);margin-top:2px"><%= camp.desc %></div>
              </div>
            </div>
            <% if (camp.paused) { %>
              <span class="badge badge-off">Paused</span>
            <% } else { %>
              <span class="badge badge-on">Active</span>
            <% } %>
          </div>

          <div class="campaign-card-body">
            <div class="campaign-kv">
              <span class="ck">Sender</span>
              <span class="cv"><%= camp.sender %></span>
            </div>
            <div class="campaign-kv">
              <span class="ck">Window</span>
              <span class="cv"><%= sendWindow %> &middot; <%= tz %></span>
            </div>
            <div class="campaign-kv">
              <span class="ck">Subject</span>
              <span class="cv" style="font-family:inherit;font-size:13px;font-style:italic;color:var(--fg-muted)">&ldquo;<%= camp.subject %>&rdquo;</span>
            </div>
            <div style="display:flex;gap:16px;margin-top:4px">
              <div style="text-align:center">
                <div style="font-size:22px;font-weight:700;font-family:var(--mono)"><%= camp.leads %></div>
                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--fg-muted)">Leads</div>
              </div>
              <div style="text-align:center">
                <div style="font-size:22px;font-weight:700;font-family:var(--mono);color:<%= camp.sent > 0 ? 'var(--success)' : 'var(--fg-muted)' %>"><%= camp.sent %></div>
                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--fg-muted)">Sent</div>
              </div>
            </div>
          </div>

          <div class="campaign-card-foot">
            <form action="/dashboard/campaigns/<%= camp.key %>/toggle" method="post" style="display:flex;align-items:center;gap:10px">
              <label class="toggle-switch" title="<%= camp.paused ? 'Click to activate' : 'Click to pause' %>">
                <input type="checkbox" <%= camp.paused ? '' : 'checked' %>
                  onchange="this.form.submit()"
                  aria-label="Toggle <%= camp.label %>">
                <span class="toggle-slider"></span>
              </label>
              <span class="toggle-label" style="color:<%= camp.paused ? 'var(--fg-muted)' : 'var(--success)' %>">
                <%= camp.paused ? 'Paused — click to activate' : 'Active — click to pause' %>
              </span>
            </form>
          </div>

        </div>
        <% }); %>
      </div>

      <div style="margin-top:28px;padding:18px 20px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius);font-size:13px;color:var(--fg-muted);line-height:1.7">
        <strong style="color:var(--fg);display:block;margin-bottom:4px">How campaigns work</strong>
        When a new lead arrives via your webhook, the matching campaign fires automatically — sending your template email from the configured sender address within the next available send window. Pausing a campaign stops new automated emails for that lead type. Leads are still recorded either way.
      </div>

      <%
        // ── Batch Campaigns ──────────────────────────────────────────────────
        const stateLabel = { ready: 'Ready', active: 'Sending', complete: 'Complete', empty: 'Empty' };
        const stateBadge = { ready: 'badge-off', active: 'badge-on', complete: 'badge-on', empty: 'badge-off' };
        const stateColor = { ready: 'var(--fg-muted)', active: 'var(--success)', complete: 'var(--fg-muted)', empty: 'var(--fg-muted)' };
      %>
      <% if (typeof batchCampaigns !== 'undefined' && batchCampaigns.length) { %>
      <div style="margin-top:36px">
        <h2 style="margin:0 0 6px;font-size:16px;font-weight:700">Batch Campaigns</h2>
        <p style="margin:0 0 18px;color:var(--fg-muted);font-size:13px">One-time outreach campaigns imported from a lead list. Activate when your sender Gmail is connected.</p>

        <% batchCampaigns.forEach(function(bc) { %>
        <%
          const st = bc.status;
          const isActive = st.state === 'active';
          const isReady  = st.state === 'ready';
        %>
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px 22px;margin-bottom:16px">

          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px">
            <div style="display:flex;align-items:center;gap:10px">
              <span style="font-size:22px"><%= bc.icon %></span>
              <div>
                <div style="font-weight:700;font-size:15px"><%= bc.label %></div>
                <div style="font-size:12px;color:var(--fg-muted);margin-top:2px">Tag: <code style="font-family:var(--mono);font-size:11px"><%= bc.tag %></code></div>
              </div>
            </div>
            <span class="badge <%= stateBadge[st.state] || 'badge-off' %>"><%= stateLabel[st.state] || st.state %></span>
          </div>

          <%
            const isOverdue   = st.overdue > 0;
            const lastSentAgo = st.lastSentAt ? Math.floor((Date.now() - st.lastSentAt) / 60000) : null;
            // "stuck" = active campaign but overdue messages and nothing sent in 30+ min
            const isStuck = isActive && isOverdue && (lastSentAgo === null || lastSentAgo > 30);
          %>
          <div style="display:flex;gap:24px;margin-bottom:18px;flex-wrap:wrap">
            <div style="text-align:center">
              <div style="font-size:20px;font-weight:700;font-family:var(--mono);color:var(--fg-muted)"><%= st.scheduled %></div>
              <div style="font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--fg-muted)">Draft</div>
            </div>
            <div style="text-align:center">
              <div style="font-size:20px;font-weight:700;font-family:var(--mono);color:<%= st.queued > 0 ? 'var(--accent)' : 'var(--fg-muted)' %>"><%= st.queued %></div>
              <div style="font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--fg-muted)">Queued</div>
            </div>
            <div style="text-align:center">
              <div style="font-size:20px;font-weight:700;font-family:var(--mono);color:<%= st.sent > 0 ? 'var(--success)' : 'var(--fg-muted)' %>"><%= st.sent %></div>
              <div style="font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--fg-muted)">Sent</div>
            </div>
            <div style="text-align:center">
              <div style="font-size:20px;font-weight:700;font-family:var(--mono)"><%= st.total %></div>
              <div style="font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--fg-muted)">Total</div>
            </div>
            <% if (st.lastSentAt) { %>
            <div style="text-align:center">
              <div style="font-size:13px;font-weight:600;font-family:var(--mono);color:var(--success)">
                <%= lastSentAgo < 60 ? lastSentAgo + 'm ago' : Math.floor(lastSentAgo/60) + 'h ago' %>
              </div>
              <div style="font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--fg-muted)">Last Sent</div>
            </div>
            <% } %>
          </div>

          <% if (isStuck) { %>
          <div style="margin-bottom:14px;padding:12px 14px;background:#fff3cd;border:1px solid #ffc107;border-radius:6px;font-size:13px;color:#856404;line-height:1.6">
            <strong>⚠️ <%= st.overdue %> email<%= st.overdue === 1 ? '' : 's' %> overdue and not sending.</strong>
            The campaign is ON but emails are not going out — the send cron may not be running.
            <% if (!st.lastSentAt) { %>
              No emails have been sent yet from this campaign.
            <% } else { %>
              Last sent <%= lastSentAgo %> minutes ago.
            <% } %>
            Contact support or check the Vercel cron logs.
          </div>
          <% } %>

          <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">

            <% if (isReady) { %>
            <form action="/dashboard/campaigns/bulk/<%= bc.tag %>/activate" method="post" style="display:flex;align-items:center;gap:8px">
              <label style="font-size:13px;color:var(--fg-muted)">Spread over</label>
              <select name="num_days" class="input" style="height:34px;width:90px;font-size:13px;padding:0 8px">
                <option value="1">1 day</option>
                <option value="2" selected>2 days</option>
                <option value="3">3 days</option>
                <option value="5">5 days</option>
              </select>
              <button type="submit" class="btn" style="background:var(--success);border-color:var(--success);color:#fff;height:34px;padding:0 18px;font-size:13px">
                ▶ Activate Campaign
              </button>
            </form>
            <% } %>

            <% if (isActive) { %>
            <% if (isStuck) { %>
            <div style="font-size:13px;color:#856404;font-weight:600">⚠️ Queued but NOT sending — cron issue</div>
            <% } else { %>
            <div style="font-size:13px;color:var(--success);font-weight:600">&#9679; Sending — bursts of 3–5 emails, 40–70 min apart</div>
            <% } %>
            <form action="/dashboard/campaigns/bulk/<%= bc.tag %>/deactivate" method="post" style="margin-left:auto">
              <button type="submit" class="btn btn-ghost" style="height:34px;font-size:13px;color:var(--fg-muted)"
                onclick="return confirm('Pause this campaign? Queued emails will return to draft.')">
                ⏸ Pause
              </button>
            </form>
            <% } %>

            <% if (st.state === 'complete') { %>
            <div style="font-size:13px;color:var(--fg-muted)">&#10003; All emails sent.</div>
            <% } %>

            <% if (st.state === 'empty') { %>
            <div style="font-size:13px;color:var(--fg-muted)">No messages imported yet. Run <code style="font-family:var(--mono);font-size:12px">import-ocbv-leads.js</code> first.</div>
            <% } %>

          </div>

          <% if (isReady) { %>
          <div style="margin-top:14px;padding:10px 14px;background:var(--surface-2);border-radius:6px;font-size:12px;color:var(--fg-muted);line-height:1.6">
            <strong style="color:var(--fg)">Before activating:</strong>
            make sure <strong>max@dmrmedia.org</strong> is connected via Gmail (sign in from the onboarding page)
            and the <strong>buyer sender</strong> is set to max@dmrmedia.org under
            <a href="/dashboard/template" style="color:var(--accent)">Templates</a>.
          </div>
          <% } %>

        </div>
        <% }); %>
      </div>
      <% } %>

    </div>
    </main>
  </div><!-- /.dash-body -->

  <footer class="foot">
    <span>&copy; <%= new Date().getFullYear() %> <%= brand.name %></span>
    <span class="mono" style="font-size:11px"><%= brand.domain %></span>
  </footer>
</div>
</body>
</html>
