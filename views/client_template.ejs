<%
  const title = 'Template';
  const page = 'template';
%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %> — <%= brand.name %> · <%= brand.tagline %></title>
<link rel="stylesheet" href="/static/css/dmr.css" />
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">DMR</div>
      <div class="brand-text">
        <span class="name"><%= brand.name %></span>
        <span class="tagline"><%= brand.tagline %></span>
      </div>
    </div>
    <nav class="nav">
      <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/dashboard/template" class="<%= page === 'template' ? 'active' : '' %>">Template</a>
      <span style="color:var(--fg-muted);font-size:12px;margin:0 6px"><%= client.google.email || client.agent_email %></span>
      <% if (typeof isAdminImpersonating !== 'undefined' && isAdminImpersonating) { %>
        <form action="/admin/stop-impersonating" method="post" style="display:inline;margin-left:6px">
          <button class="btn" type="submit" style="background:#F59E0B;color:#000;border-color:#F59E0B">← Admin Panel</button>
        </form>
      <% } else { %>
        <form action="/auth/logout" method="post" style="display:inline">
          <button class="btn btn-ghost" type="submit">Sign out</button>
        </form>
      <% } %>
    </nav>
  </header>
  <main class="main">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
  <% } %>

<h1>Email template</h1>
<p class="lede">Set separate templates for buyer and seller leads, plus your business-hour sending window.</p>

<form action="/dashboard/template" method="post" class="panel">
  <h2 style="margin-top:0">Buyer template</h2>
  <label>Buyer subject <span class="req">*</span></label>
  <input class="input" name="buyer_template_subject" required value="<%= client.templates?.buyer?.subject || client.template.subject %>" />

  <label>Buyer body <span class="req">*</span></label>
  <textarea class="textarea" name="buyer_template_body" rows="8" required><%= client.templates?.buyer?.body || client.template.body %></textarea>

  <h2>Seller template</h2>
  <label>Seller subject <span class="req">*</span></label>
  <input class="input" name="seller_template_subject" required value="<%= client.templates?.seller?.subject || client.template.subject %>" />

  <label>Seller body <span class="req">*</span></label>
  <textarea class="textarea" name="seller_template_body" rows="8" required><%= client.templates?.seller?.body || client.template.body %></textarea>

  <h2>Designated senders</h2>
  <p class="help" style="margin-top:0">Choose which team member's Gmail account sends each template type. Only connected accounts appear here.</p>
  <div class="row">
    <div>
      <label>Buyer lead sender</label>
      <select class="input" name="buyer_sender_email" style="height:38px">
        <option value="">— Use default (owner account) —</option>
        <% (teamMembers || []).filter(u => u.connected).forEach(u => { %>
          <option value="<%= u.email %>" <%= (client.settings?.buyer_sender_email || '') === u.email ? 'selected' : '' %>>
            <%= u.name || u.email %> (<%= u.email %>)<%= u.role === 'owner' ? ' ★' : '' %>
          </option>
        <% }) %>
      </select>
    </div>
    <div>
      <label>Seller lead sender</label>
      <select class="input" name="seller_sender_email" style="height:38px">
        <option value="">— Use default (owner account) —</option>
        <% (teamMembers || []).filter(u => u.connected).forEach(u => { %>
          <option value="<%= u.email %>" <%= (client.settings?.seller_sender_email || '') === u.email ? 'selected' : '' %>>
            <%= u.name || u.email %> (<%= u.email %>)<%= u.role === 'owner' ? ' ★' : '' %>
          </option>
        <% }) %>
      </select>
    </div>
  </div>

  <h2>Signature</h2>
  <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
    <input type="checkbox" name="team_signature_enabled" style="width:16px;height:16px"
      <%= client.settings?.team_signature_enabled ? 'checked' : '' %> />
    <span>Append "<%= client.name %> Team" to every outgoing email</span>
  </label>
  <p class="help" style="margin-top:6px">When checked, the line "<%= client.name %> Team" is added below the agent's name and phone in every email.</p>

  <h2>Delivery</h2>
  <label>CC email <span style="font-size:11px">(copied on every outbound email)</span></label>
  <input class="input" type="email" name="cc_email" value="<%= client.settings?.cc_email || '' %>" placeholder="partner@brokerage.com or leave blank" />
  <p class="help">A second inbox that receives a copy of every automated reply. Leave blank for none.</p>

  <h2>Send window</h2>
  <div class="row">
    <div>
      <label>Start (HH:MM, 24h)</label>
      <input class="input" name="send_window_start" value="<%= client.settings?.send_window_start || '08:30' %>" />
    </div>
    <div>
      <label>End (HH:MM, 24h)</label>
      <input class="input" name="send_window_end" value="<%= client.settings?.send_window_end || '18:00' %>" />
    </div>
  </div>
  <div class="row">
    <div>
      <label>Timezone (IANA)</label>
      <input class="input" name="timezone" value="<%= client.settings?.timezone || 'America/Chicago' %>" />
    </div>
    <div>
      <label>Daily send cap</label>
      <input class="input" type="number" min="1" max="250" name="daily_send_limit" value="<%= client.settings?.daily_send_limit || 5 %>" />
    </div>
  </div>

  <p class="help">
    <strong>Available placeholders:</strong>
    <span class="mono">{{first_name}}</span>
    <span class="mono">{{last_name}}</span>
    <span class="mono">{{full_name}}</span>
    <span class="mono">{{email}}</span>
    <span class="mono">{{phone}}</span>
    <span class="mono">{{property_address}}</span>
    <span class="mono">{{property_url}}</span>
    <span class="mono">{{message}}</span>
    <span class="mono">{{agent_name}}</span>
    <span class="mono">{{agent_phone}}</span>
  </p>

  <div class="actions" style="margin-top:20px">
    <button type="submit" class="btn btn-primary">Save template</button>
    <a class="btn" href="/dashboard">Cancel</a>
  </div>
</form>

<div class="panel">
  <h2 style="margin-top:0">How buyer vs seller is determined</h2>
  <p class="help" style="margin-top:0">When a webhook arrives, the system checks these signals in order and uses the first match:</p>
  <ol style="color:var(--fg-muted);line-height:2;padding-left:20px;margin:0 0 12px;font-size:13px">
    <li><strong style="color:var(--fg)">LP tags</strong> — if the payload includes tags like <span class="mono">seller</span>, <span class="mono">listing</span>, or <span class="mono">sell</span> → seller. Tags like <span class="mono">buyer</span>, <span class="mono">buy</span>, <span class="mono">renter</span> → buyer.</li>
    <li><strong style="color:var(--fg)">Lead source / action</strong> — <span class="mono">HOME_VALUE</span> → seller. <span class="mono">NEWSLETTER_SIGNUP</span> is skipped entirely (no email sent).</li>
    <li><strong style="color:var(--fg)">Explicit type field</strong> — if the payload has a <span class="mono">lead_type</span> or <span class="mono">inquiryType</span> field containing seller/buyer keywords.</li>
    <li><strong style="color:var(--fg)">Source URL</strong> — seller pages: <span class="mono">/sell</span>, <span class="mono">/home-value</span>, <span class="mono">/listing-inquiry</span>, <span class="mono">/list-my</span>, <span class="mono">/list-your</span>. Buyer pages: <span class="mono">/buy</span>, <span class="mono">/listings</span>, <span class="mono">/home-search</span>.</li>
    <li><strong style="color:var(--fg)">Message text</strong> — scans the lead's message for seller intent phrases like "sell", "list my home", "home worth", "cash offer", etc.</li>
    <li><strong style="color:var(--fg)">Default</strong> — if nothing above matches, treated as a <strong>buyer</strong>.</li>
  </ol>
  <p class="help" style="margin-bottom:0"><strong>Skipped sources</strong> (no email sent at all): <span class="mono">NEWSLETTER_SIGNUP</span></p>
</div>

<div class="panel">
  <h2 style="margin-top:0">Tips for good lead emails</h2>
  <ul style="color:var(--fg-muted);line-height:1.8;padding-left:20px;margin:0">
    <li>Plain text only — no HTML, no images. Looks like a personal email, not a marketing blast.</li>
    <li>Keep it under 5 sentences. Long emails read as automated.</li>
    <li>End with a single, clear question (e.g. "When works best for you?").</li>
    <li>Sign with your name and phone — replies will come straight to your Gmail inbox.</li>
  </ul>
</div>

  </main>
  <footer class="foot">
    <span>&copy; <%= new Date().getFullYear() %> <%= brand.name %></span>
    <span class="mono"><%= brand.domain %></span>
  </footer>
</div>
</body>
</html>
