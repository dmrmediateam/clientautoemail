# =============================================================
# DMR Media Lead Response Bridge — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# =============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
# In production: PUBLIC_BASE_URL=https://email.dmrmedia.org

# --- Branding ---
BRAND_NAME=DMR Media
BRAND_TAGLINE=Lead Response Bridge
BRAND_DOMAIN=dmrmedia.org

# --- Admin login (single password gate for the dashboard) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=replace-with-32+-random-chars

# --- Token encryption (AES-256-GCM) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Google OAuth + Gmail API ---
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: ${PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile

# --- Database ---
# SQLite file path (relative to project root). Use Postgres URL in production.
DATABASE_PATH=./data/bridge.db

# --- Admin alerts (when OAuth revocation / send failures happen) ---
ADMIN_ALERT_EMAIL=ops@dmrmedia.org
