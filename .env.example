# =============================================================
# DMR Media Lead Response Bridge — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# =============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
# In production: PUBLIC_BASE_URL=https://email.dmrmedia.org

# --- Branding ---
BRAND_NAME=DMR Media
BRAND_TAGLINE=Lead Response Bridge
BRAND_DOMAIN=dmrmedia.org

# --- Admin login (single password gate for the dashboard) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=replace-with-32+-random-chars

# --- Token encryption (AES-256-GCM) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Google OAuth + Gmail API ---
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: ${PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile

# --- Database (Postgres) ---
# Vercel Postgres / Neon connection string. Pooled URL preferred for serverless.
# When linked via Vercel integration, POSTGRES_URL is also auto-injected and used as fallback.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Set DATABASE_SSL=false only for plaintext local Postgres.
DATABASE_SSL=true

# --- Admin alerts (when OAuth revocation / send failures happen) ---
ADMIN_ALERT_EMAIL=ops@dmrmedia.org

# --- Scheduling / cron ---
CRON_SECRET=replace-with-random-secret

# --- Gmail Push (Pub/Sub) ---
# Example: projects/your-project/topics/gmail-inbox-events
GMAIL_PUBSUB_TOPIC=
# Optional verification token for /v1/webhooks/gmail/push?token=...
GMAIL_PUSH_VERIFICATION_TOKEN=
